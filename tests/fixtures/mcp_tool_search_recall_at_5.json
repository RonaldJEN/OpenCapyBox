{
  "name": "MCP deferred tool search Recall@5 benchmark",
  "version": 1,
  "metric": "recall_at_5",
  "pass_rule": {
    "positive": "top_5_model_tools intersects expected_any",
    "negative": "top_5_model_tools is empty"
  },
  "cases": [
    {
      "id": "company_deep_01",
      "category": "company_deep_analysis",
      "query": "我第一次研究宁德时代，帮我把业务、竞争力、财务表现和主要风险完整梳理一下",
      "expected_any": ["stock-one-page", "stock-investment-logic"]
    },
    {
      "id": "company_deep_02",
      "category": "company_deep_analysis",
      "query": "中际旭创这家公司到底是做什么的，收入从哪来，未来增长靠什么",
      "expected_any": ["stock-one-page", "stock-investment-logic"]
    },
    {
      "id": "company_deep_03",
      "category": "company_deep_analysis",
      "query": "给我做一份药明康德的完整案头研究，重点看商业模式、客户结构和风险",
      "expected_any": ["stock-one-page"]
    },
    {
      "id": "company_deep_04",
      "category": "company_deep_analysis",
      "query": "老板明天要见隆基绿能，先让我快速了解这家公司现在的经营状况和核心问题",
      "expected_any": ["stock-one-page", "stock-survey-outline"]
    },
    {
      "id": "company_deep_05",
      "category": "company_deep_analysis",
      "query": "全面拆解一下三一重工，产品、海外业务、行业位置和周期风险都要看",
      "expected_any": ["stock-one-page", "stock-investment-logic"]
    },
    {
      "id": "investment_logic_01",
      "category": "investment_logic",
      "query": "贵州茅台现在还值得长期跟踪吗，最关键的支撑逻辑是什么",
      "expected_any": ["stock-investment-logic"]
    },
    {
      "id": "investment_logic_02",
      "category": "investment_logic",
      "query": "小米集团接下来有哪些催化剂，哪些因素可能导致逻辑被证伪",
      "expected_any": ["stock-investment-logic"]
    },
    {
      "id": "investment_logic_03",
      "category": "investment_logic",
      "query": "阳光电源当前最重要的多空矛盾是什么",
      "expected_any": ["stock-investment-logic", "view-challenge"]
    },
    {
      "id": "investment_logic_04",
      "category": "investment_logic",
      "query": "最近中国船舶为什么涨，背后的基本面逻辑能持续多久",
      "expected_any": ["stock-investment-logic", "qa-text"]
    },
    {
      "id": "company_compare_01",
      "category": "company_comparison",
      "query": "比亚迪最应该和哪几家公司对标，商业模式分别有什么差异",
      "expected_any": ["comparable-companies"]
    },
    {
      "id": "company_compare_02",
      "category": "company_comparison",
      "query": "对比中芯国际和华虹半导体的产品结构、制程、客户与盈利能力",
      "expected_any": ["comparable-companies"]
    },
    {
      "id": "company_compare_03",
      "category": "company_comparison",
      "query": "宁德时代在海外有哪些真正可比的电池公司",
      "expected_any": ["comparable-companies"]
    },
    {
      "id": "company_compare_04",
      "category": "company_comparison",
      "query": "贵州茅台和五粮液谁的渠道质量、品牌力和增长空间更好",
      "expected_any": ["comparable-companies"]
    },
    {
      "id": "company_research_01",
      "category": "company_research",
      "query": "下周要去调研海康威视，见管理层最应该问哪些问题",
      "expected_any": ["stock-survey-outline"]
    },
    {
      "id": "company_research_02",
      "category": "company_research",
      "query": "帮我准备一份汇川技术专家访谈的问题清单",
