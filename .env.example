# OpenCapyBox 后端环境变量示例
# 标注说明：
# - [必填] 启动项目必须配置
# - [可选] 不配置则使用默认值
# - [按需必填] 启用对应功能时必须配置

# ============================================================
# [必填] 基础与认证
# ============================================================
APP_NAME="OpenCapyBox Backend"
DEBUG=true

# 首次启动 bootstrap 登录账号（格式：username:password,username2:password2）
# auth_users 表非空后不再同步此变量
SIMPLE_AUTH_USERS="replace-user:replace-with-a-strong-unique-password"

# 首次启动 bootstrap 管理员账号（逗号分隔，需出现在 SIMPLE_AUTH_USERS 中）
AUTH_ADMIN_USERS="replace-user"

# LDAP 直连认证：auth_users.auth_type=ldap 的用户通过统一登录入口校验目录账号密码
LDAP_URLS=""                             # 例：ldaps://ldap.example.local,ldaps://ldap-backup.example.local:636
LDAP_USER_DOMAIN=""                      # 可选；填 example.local 时用 username@example.local 绑定

# JWT 签名密钥（生产环境必填，至少 32 个随机字符；示例值无法启动生产模式）
AUTH_SECRET_KEY="replace-with-a-random-secret-string"
AUTH_TOKEN_EXPIRE_MINUTES=720

# MCP 凭证与待审批参数加密密钥。生产环境必须独立设置至少 32 个随机字符，
# 并在多 Worker 间保持一致；仅 DEBUG=true 时允许从进程随机 AUTH_SECRET_KEY 派生。
MCP_SECRET_KEY="replace-with-an-independent-random-secret-string"
# 管理后台“测试连接”的总超时（秒）
MCP_TEST_TIMEOUT_SECONDS=15
# 有有效 MCP 连接时，周期性重新拉取远端 tools/list 的最长间隔（秒）
MCP_CATALOG_REFRESH_SECONDS=300
# 进程内 MCP 目录缓存：用户 LRU 数量、逻辑字节总预算、空闲过期时间（秒）
MCP_CATALOG_CACHE_MAX_USERS=64
MCP_CATALOG_CACHE_MAX_BYTES=67108864
MCP_CATALOG_CACHE_IDLE_TTL_SECONDS=900
# 每个用户最多保存的个人 MCP 数量
MCP_PERSONAL_SERVER_LIMIT=20
# 每个用户最多启用的可选 MCP 连接数（平台必需连接不计入）
MCP_USER_ENABLED_CONNECTION_LIMIT=20
# 平台最多可配置的平台必需官方 MCP 数量
MCP_REQUIRED_OFFICIAL_SERVER_LIMIT=10
# 单个服务发现、单用户完整目录构建的墙钟超时（秒）
MCP_DISCOVERY_TIMEOUT_SECONDS=60
MCP_CATALOG_BUILD_TIMEOUT_SECONDS=120
# 单次 tools/call 从 DNS、握手到结果返回的强制墙钟期限（秒，不能关闭）
MCP_CALL_TIMEOUT_SECONDS=300
# MCP 连接/初始化在 tools/call 发送前的总尝试次数（含首次尝试）
MCP_CONNECT_RETRY_ATTEMPTS=3
# 发送前重连的指数退避基准秒数（第 2/3 次尝试前分别等待 1x/2x）
MCP_CONNECT_RETRY_BASE_DELAY_SECONDS=0.5
# 单进程内的发现并发与单用户目录规模上限
MCP_MAX_CONCURRENT_DISCOVERIES_PER_USER=8
MCP_MAX_CONCURRENT_DISCOVERIES_GLOBAL=16
MCP_MAX_INSTALLATIONS_PER_USER=32
MCP_MAX_TOOLS_PER_USER=2048

# 已批准工具的执行 lease（秒）。执行期间按 heartbeat 续租；过期后只会
# 标记为 unknown，表示外部副作用结果未知，系统绝不自动重试。
TOOL_APPROVAL_EXECUTION_LEASE_SECONDS=120
TOOL_APPROVAL_LEASE_HEARTBEAT_SECONDS=30
TOOL_APPROVAL_RECONCILE_INTERVAL_SECONDS=30

# ============================================================
# [可选] API / 数据库 / CORS
# ============================================================
API_PREFIX="/api"

# 数据库（仅支持 PostgreSQL）
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 测试数据库（pytest 集成测试使用）
TEST_DATABASE_URL="postgresql://user:password@host:5432/dbname_test"

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================================
# [按需必填] 模型能力（Model Registry）
# ============================================================
# 模型具体参数（provider / api_base / max_tokens 等）在 models.yaml 中配置。
# 此处仅填写 API Key 环境变量，供 models.yaml 的 ${ENV_VAR} 引用。
# 若不配置对应 Key，该模型会在启动时自动禁用。

# DashScope 统一密钥（Qwen / GLM / DeepSeek）
LLM_API_KEY="your-dashscope-api-key"

# MiniMax 模型需要（不用 MiniMax 可留空）
MINIMAX_API_KEY=""

# 以下变量供 models.yaml 的 ${ENV_VAR} 引用，非独立 fallback
LLM_API_BASE="https://dashscope.aliyuncs.com/compatible-mode/v1"
LLM_MODEL="qwen3-max-preview"
LLM_PROVIDER="openai"

# ============================================================
# [按需必填] OpenSandbox（代码执行 / 文件工具）
# ============================================================
SANDBOX_DOMAIN="your-sandbox-host:8080"
SANDBOX_API_KEY="your-sandbox-api-key"

# [可选] OpenSandbox 其他参数
SANDBOX_IMAGE="code-interpreter-agent:v1.1.0"
SANDBOX_PROTOCOL="http"
SANDBOX_USE_SERVER_PROXY=true
SANDBOX_TIMEOUT_MINUTES=10
SANDBOX_READY_TIMEOUT_SECONDS=120
# 后台 bash 命令服务端超时（秒）；设为 0 禁用
SANDBOX_BACKGROUND_COMMAND_TIMEOUT_SECONDS=21600
SANDBOX_PERSISTENT_STORAGE_ENABLED=true
SANDBOX_HOST_STORAGE_ROOT="/tmp/sandbox"
SANDBOX_STORAGE_MOUNT_PATH="/home/user"

# ============================================================
# [可选] Agent / SSE / 时区
# ============================================================
AGENT_MAX_STEPS=100
AGENT_MAX_HISTORY_MESSAGES=120
# AGENT_TOOL_TIMEOUT: 单次工具执行超时（秒）。设为 0 将禁用超时保护，慎用！
AGENT_TOOL_TIMEOUT=300
# 同一父 Agent step 内最多并行执行的 sub_agent 数；1 表示串行
AGENT_SUBAGENT_MAX_PARALLEL=3
# 同一用户允许同时运行的不同会话数；1 表示严格串行，3 表示最多 3 个 session 并跑
AGENT_USER_CONCURRENCY_LIMIT=1
# Skill 启停快照复用窗口（秒）：避免每步 LLM 请求都查库；改启停最迟约此值内生效。设 0 则每步实时查库
SKILL_DISABLED_CACHE_TTL_SECONDS=30

# SSE_HEARTBEAT_INTERVAL: 心跳间隔（秒）
# SSE_SUBSCRIBE_TIMEOUT: 订阅超时时间（秒）
SSE_HEARTBEAT_INTERVAL=15
SSE_SUBSCRIBE_TIMEOUT=300
AGUI_REPAIR_TERMINAL_SINCE_HOURS=24

# UTC 偏移小时数（中国大陆常用 8）
TIMEZONE_OFFSET=8

# ============================================================
# [可选] 部署参数（仅 Docker/K8s 部署时生效）
# ============================================================
# 第一版 Agent runtime 使用进程内 EventBus / cancel token / subscriber registry，
# 部署正确性假设为单 worker。
UVICORN_WORKERS=1
LOG_LEVEL="info"

# ============================================================
# [可选] 搜索与扩展模型
# ============================================================
# 博查搜索 AppCode（启用搜索工具时配置）
BOCHA_SEARCH_APPCODE=""
GEMINI_API_KEY=""

# ============================================================
# [可选] Embedding（不填则降级为关键词检索）
# ============================================================
EMBEDDING_API_KEY=""
EMBEDDING_API_BASE="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
